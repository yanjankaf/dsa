#!/bin/bash

# Check if argument is provided
if [ -z "$1" ]; then
  echo "Usage: $0 <project_name>"
  exit 1
fi

# Create the project folder
mkdir -p "$1"/bin

# Navigate to the new project directory
cd "$1"

# Create the main.c file
cat > main.c << 'EOF'
#include <stdio.h>

int main() {
    printf("Hello, World!\\n");
    return 0;
}
EOF

# Create the Makefile
cat > Makefile << 'EOF'
CC=gcc
CFLAGS=-Wall -g
BIN=./bin/main

# COMPILE target
COMPILE: main.c
	$(CC) $(CFLAGS) main.c -o $(BIN)

# RUN target depends on COMPILE
RUN: COMPILE
	$(BIN)

# Clean target (optional)
clean:
	rm -f $(BIN)
EOF

# Inform the user
echo "Project $1 created successfully!"
echo "Navigate to the folder and run 'make RUN' to compile and execute."
